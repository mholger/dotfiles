#!/bin/bash

CACHEDIR="/home/holger/.aws/login/cache"
CF=$(ls -tr ${CACHEDIR} | tail -1)

aws login
export AWS_ACCESS_KEY_ID=$(cat ${CACHEDIR}/${CF} | jq -r '.accessToken.accessKeyId')
export AWS_SECRET_ACCESS_KEY=$(cat ${CACHEDIR}/${CF} | jq -r '.accessToken.secretAccessKey')
export AWS_SESSION_TOKEN=$(cat ${CACHEDIR}/${CF} | jq -r '.accessToken.sessionToken')
